{
  "name": "@hideverse/game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --base=/game/",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/verify-build.mjs",
    "verify": "npm run verify:ravenwood && npm run verify:roadmap && npm run typecheck && npm run build && npm run smoke",
    "verify:ravenwood": "node scripts/verify-ravenwood-layout.mjs",
    "build:pages": "vite build --base=/Hideverse.io/game/",
    "build:static": "vite build --base=./",
    "verify:roadmap": "node scripts/verify-roadmap.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "playcanvas": "2.22.4",
    "yuka": "0.7.8"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
